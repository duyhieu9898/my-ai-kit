{
  "enabled": true,
  "name": "Harness Safety Guard",
  "description": "Reviews shell and write tool calls for destructive operations and high-risk Harness changes.",
  "version": "1",
  "when": {
    "type": "preToolUse",
    "toolTypes": [
      "shell",
      "write"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Review the proposed tool call before it runs. If it uses a destructive command such as rm -rf, git reset --hard, git checkout --, or git clean, continue only when the user explicitly requested that exact destructive action. If it reads or exposes .env files, credentials, tokens, passwords, private keys, or secrets, do not reveal sensitive values. If it edits auth, authorization, migrations, schemas, payments, providers, webhooks, scripts/schema/, docs/decisions/, docs/templates/high-risk-story/, or crates/harness-cli/, re-check the Harness risk lane and required context first. When a condition applies, stop the tool call and ask for the missing confirmation or context. Otherwise allow the tool call without adding unrelated work."
  }
}
